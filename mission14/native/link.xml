<!--
  IL2CPP managed-code-stripping guard for the N (RAG) port.
  ONNX Runtime, Microsoft.ML.Tokenizers, and Google.Protobuf resolve types via
  reflection, which the IL2CPP linker cannot see -> they get stripped and crash at
  runtime on Android. Preserve them here.
  Place at Assets/link.xml (any folder under Assets/ is picked up automatically).
-->
<linker>
  <assembly fullname="Microsoft.ML.OnnxRuntime" preserve="all"/>
  <assembly fullname="Microsoft.ML.Tokenizers" preserve="all"/>
  <assembly fullname="Google.Protobuf" preserve="all"/>
</linker>
