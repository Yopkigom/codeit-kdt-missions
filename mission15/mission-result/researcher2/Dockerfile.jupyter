# 베이스 이미지로 Python 3.11-slim-bookworm을 사용 (공통)
FROM python:3.11-slim-bookworm

# 작업 디렉토리를 /work으로 설정
WORKDIR /work

# 필요한 패키지 의존성 설정 먼저 복사
COPY requirements.txt .
# requirements.txt 파일을 기반으로 패키지 설치, 추가로 Jupyter Notebook(7.2.1) 설치
RUN pip install --no-cache-dir -r requirements.txt notebook==7.2.1

# 8888 포트를 사용하여 Jupyter Notebook을 실행한다고 선언
EXPOSE 8888

# jupyter notebook을 실행하도록 CMD 명령어 설정
# --ip=0.0.0.0 옵션을 사용하여 모든 IP 주소에서 접근 가능하도록 설정
# --port=8888 옵션을 사용하여 8888 포트에서 실행되도록 설정
# --no-browser 옵션을 사용하여 브라우저를 자동으로 열지 않도록
CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser"]